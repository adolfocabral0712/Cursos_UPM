{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursos-rocio-upm",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
